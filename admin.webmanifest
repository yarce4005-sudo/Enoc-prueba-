{
  "id": "./admin.html",
  "name": "ENOC · Panel de Administración",
  "short_name": "ENOC Admin",
  "description": "Panel de gestión de la tienda ENOC.",
  "lang": "es",
  "start_url": "./admin.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f3f6fc",
  "theme_color": "#0b1d3b",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}